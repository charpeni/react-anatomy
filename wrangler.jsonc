{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "react-anatomy",
  "compatibility_date": "2026-11-02",
  "assets": {
    "directory": "./packages/website/dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
  },
  // Branch builds run `wrangler preview`, which requires this block. It stays
  // empty: Previews take assets and the compatibility date from the top level.
  "previews": {},
}
