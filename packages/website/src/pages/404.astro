---
import mark from '@react-anatomy/brand/svg/mark-light.svg?url';
import '../styles/landing.css';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Page not found — React Anatomy</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/instrument-sans/latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/">
          <img src={mark} width="32" height="32" alt="" />
          <span>
            React <strong>Anatomy</strong>
          </span>
        </a>
      </header>
      <main class="hero">
        <p class="eyebrow">404 / Page not found</p>
        <h1>This page isn’t here.</h1>
        <div class="hero-links">
          <a class="watch-link" href="/">
            Back to React Anatomy <span aria-hidden="true">↗</span>
          </a>
          <a class="text-link" href="/docs/">
            Read the docs <span aria-hidden="true">↗</span>
          </a>
        </div>
      </main>
    </div>
  </body>
</html>
