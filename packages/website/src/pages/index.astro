---
import mark from '@react-anatomy/brand/svg/mark-light.svg?url';
import '../styles/landing.css';
import InteractiveDemo from '../components/InteractiveDemo.astro';
import ExplodedHero from '../components/ExplodedHero.astro';
import ImageLightbox from '../components/ImageLightbox.astro';
import BrandMark from '../components/BrandMark.astro';
import Seo from '../components/Seo.astro';
import Pirsch from '../components/Pirsch.astro';
import { site } from '../lib/site.ts';
import { Image } from 'astro:assets';
import compositionFront from '../../public/media/composition-front.png';
import autoDepth from '../../public/media/auto-depth.png';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo title={site.title} description={site.description} />
    <Pirsch />
    <meta name="theme-color" content="#fafaf8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="preload"
      href="/fonts/instrument-sans/latin-wght-normal.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <div class="shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="React Anatomy home">
          <BrandMark size={32} animate />
          <span>
            React <strong>Anatomy</strong>
          </span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/docs/">
            Documentation <span aria-hidden="true">↗</span>
          </a>
          <a href="https://github.com/charpeni/react-anatomy">
            GitHub <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </header>

      <main id="main">
        <ExplodedHero />

        <InteractiveDemo />

        <section class="browser-support" aria-labelledby="browser-support-title">
          <div class="install-intro">
            <h2 id="browser-support-title">Install the extension</h2>
            <a class="install-compat" href="/docs/compatibility/">
              Compatibility notes
            </a>
          </div>
          <div class="browser-routes">
            <div class="browser-route">
              <p class="route-store">Chrome Web Store</p>
              <a
                class="install-button"
                href="https://chromewebstore.google.com/detail/react-anatomy/cllgnlljmehhoemdlfngkkpienkglkml"
              >
                <img src="/media/browsers/chrome.svg" width="18" height="18" alt="" />
                <span>Add to Chrome</span>
                <span class="install-arrow" aria-hidden="true">
                  ↗
                </span>
              </a>
              <p class="route-also">
                <span class="install-logos" aria-hidden="true">
                  <img src="/media/browsers/brave.svg" width="16" height="16" alt="" />
                  <img src="/media/browsers/edge.png" width="16" height="16" alt="" />
                </span>
                Also installs in Brave and Edge.
              </p>
            </div>
            <div class="browser-route">
              <p class="route-store">Firefox Add-ons</p>
              <div class="browser-availability">
                <img src="/media/browsers/firefox.png" width="20" height="20" alt="" />
                <strong>Firefox</strong>
                <span class="availability-help">
                  <button
                    class="availability-badge"
                    type="button"
                    aria-describedby="firefox-availability-tooltip"
                  >
                    Coming soon
                  </button>
                  <span
                    class="availability-tooltip"
                    id="firefox-availability-tooltip"
                    role="tooltip"
                    hidden
                  >
                    <span>The download link will appear here shortly.</span>
                  </span>
                </span>
              </div>
            </div>
          </div>
        </section>

        <section class="origin" aria-labelledby="origin-title">
          <div class="origin-copy">
            <p class="eyebrow">Where it comes from</p>
            <h2 id="origin-title">The diagram I used to draw by hand.</h2>
          </div>
          <div class="origin-text">
            <p>
              To understand a screen, or to explain a change in a pull request, I would open
              Excalidraw and draw boxes: this region is the sidebar, these cards come from a list,
              the badge lives inside each card. It took time, and it was my reading of the code, not
              what React actually rendered.
            </p>
            <p>
              React Anatomy builds that picture from the running page. The layers come from what is
              on screen; the names and the nesting come from React itself.
            </p>
          </div>
          <div class="origin-compare">
            <figure class="sketch">
              <a href="/media/diagrams/page-composition.svg">
                <img
                  src="/media/diagrams/page-composition.svg"
                  width="1048"
                  height="660"
                  loading="lazy"
                  alt="An Excalidraw diagram of the page: a sidebar with a switcher, navigation and profile, and a main area containing a header, a list of three cards, and an activity feed. The list and a handwritten question mark are highlighted in blue."
                />
              </a>
              <figcaption>
                Before: a schema drawn in Excalidraw, from memory and the source.
              </figcaption>
            </figure>
            <figure>
              <a href="/media/composition-front.png">
                <Image
                  src={compositionFront}
                  widths={[640, 960, 1440, 1920]}
                  sizes="(min-width: 1440px) 685px, (min-width: 900px) 50vw, 100vw"
                  format="webp"
                  quality={90}
                  loading="lazy"
                  alt="The Orbit page viewed from the front in Anatomy, with separated component layers, labels for the sidebar, cards and activity feed, and the project list outlined in blue."
                />
              </a>
              <figcaption>
                Now: the layout in Anatomy, viewed from the front with its component layers
                separated.
              </figcaption>
            </figure>
          </div>
        </section>

        <section class="uses" aria-labelledby="uses-title">
          <div class="section-heading">
            <p class="eyebrow">When it helps</p>
            <h2 id="uses-title">
              For the moments you need to understand a page,
              <br />
              not just change it.
            </h2>
          </div>
          <ol class="use-list">
            <li>
              <span class="feature-number">01</span>
              <h3>Find your way in an unfamiliar layout.</h3>
              <p>
                New codebase, or a page someone else built? Pick what you see and learn which
                component renders it, and where it sits.
              </p>
              <a class="text-link" href="/docs/understand/">
                Understand a page <span aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <span class="feature-number">02</span>
              <h3>Learn how React composes a page.</h3>
              <p>
                See parents, children and repeated components as one structure, and follow the props
                a list hands to each of its items.
              </p>
              <a class="text-link" href="/docs/understand/#follow-the-data">
                Follow the data <span aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <span class="feature-number">03</span>
              <h3>Investigate something unexpected.</h3>
              <p>
                A region in the wrong place, or a value that looks off? Find the component that
                rendered it and read the props it actually received.
              </p>
              <a class="text-link" href="/docs/props/">
                Inspect props <span aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <span class="feature-number">04</span>
              <h3>Explain a change to a reviewer.</h3>
              <p>
                Focus the part you changed, take a screenshot, and describe the structure in your
                pull request, next to the diff.
              </p>
              <a class="text-link" href="/docs/explain-a-change/">
                Explain a change <span aria-hidden="true">↗</span>
              </a>
            </li>
            <li>
              <span class="feature-number">05</span>
              <h3>Read what an agent built.</h3>
              <p>
                Before you take ownership of a page an AI agent wrote, look at what it rendered:
                which components, how deeply nested, and with which props.
              </p>
              <a class="text-link" href="/docs/generated-code/">
                Read generated code <span aria-hidden="true">↗</span>
              </a>
            </li>
            <li class="use-note">
              <span class="feature-number">A note on scope</span>
              <p>
                React Anatomy shows structure; it doesn’t grade it. It is an inspector, not a code
                reviewer. Whether a structure is right stays your call.
              </p>
            </li>
          </ol>
        </section>

        <section class="overview" aria-labelledby="overview-title">
          <div class="overview-copy">
            <p class="eyebrow">What you’re looking at</p>
            <h2 id="overview-title">
              The tree React rendered.
              <br />
              Not your import graph.
            </h2>
            <p>
              Anatomy reads the components React rendered for this page, right now. A component that
              is imported but not on screen doesn’t appear. One rendered three times appears three
              times, each with its own props. Files, imports and dependencies are a different map.
            </p>
            <p>
              The 3D view starts from the shape of the page. Auto depth separates each visible
              region, and wrappers with identical output share a plane. Every captured component
              stays in the tree.
            </p>
            <a class="text-link" href="/docs/explore/">
              How layers and depth work <span aria-hidden="true">↗</span>
            </a>
          </div>
          <figure>
            <a href="/media/auto-depth.png">
              <Image
                src={autoDepth}
                widths={[640, 960, 1440]}
                sizes="(min-width: 1440px) 749px, (min-width: 900px) 55vw, 100vw"
                format="webp"
                quality={90}
                loading="lazy"
                alt="The Anatomy panel showing the sidebar, main content, cards and composer as separate layers, with Layer depth set to Auto."
              />
            </a>
            <figcaption>
              Auto depth on a layout with a deep chain of containers: the useful regions still get
              their own layers.
            </figcaption>
          </figure>
        </section>

        <section class="notes" aria-labelledby="notes-title">
          <div>
            <p class="eyebrow">A tool in the making</p>
            <h2 id="notes-title">Built for understanding.</h2>
            <p>
              React Anatomy reads a running React app, with no package or code changes required.
              Inspection happens in your browser.
            </p>
            <p>
              It uses React’s private internals, so compatibility and visual fidelity can vary. The
              docs explain what it can see today.
            </p>
          </div>
          <div class="doc-links">
            <a href="/docs/">
              <span>
                The mental model<small>The page, its component tree, and how they connect</small>
              </span>
              <span aria-hidden="true">↗</span>
            </a>
            <a href="/docs/understand/">
              <span>
                Understand a page<small>From something you see to the component behind it</small>
              </span>
              <span aria-hidden="true">↗</span>
            </a>
            <a href="/docs/explain-a-change/">
              <span>
                Explain a change<small>Show the structure in a pull request</small>
              </span>
              <span aria-hidden="true">↗</span>
            </a>
            <a href="/docs/limitations/">
              <span>
                What to expect today<small>Capture limits and compatibility</small>
              </span>
              <span aria-hidden="true">↗</span>
            </a>
            <a href="/docs/faq/">
              <span>
                Common questions<small>React DevTools, production builds, and privacy</small>
              </span>
              <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
      </main>
      <footer>
        <a class="brand" href="/">
          <img src={mark} width="24" height="24" alt="" />
          <span>
            React <strong>Anatomy</strong>
          </span>
        </a>
        <p>A clearer picture of how your page is composed.</p>
        <nav class="footer-links" aria-label="Footer navigation">
          <a href="/docs/">
            Documentation <span aria-hidden="true">↗</span>
          </a>
          <a href="/privacy/">Privacy policy</a>
        </nav>
      </footer>
    </div>
    <ImageLightbox />
    <script>
      // Touch browsers may defer :active until release. Track the real pointer
      // press without cancelling clicks, pointer defaults, or page scrolling.
      const pressable = document.querySelectorAll<HTMLElement>(
        '.install-button, .demo-steps button',
      );
      const releasePress = () => {
        pressable.forEach((control) => delete control.dataset.pointerPressed);
      };
      pressable.forEach((control) => {
        control.addEventListener('pointerdown', (event) => {
          if (!event.isPrimary || event.button !== 0 || control.matches(':disabled')) {
            return;
          }
          releasePress();
          control.dataset.pointerPressed = '';
        });
        control.addEventListener('pointerleave', releasePress);
      });
      document.addEventListener('pointerup', releasePress, true);
      document.addEventListener('pointercancel', releasePress, true);
      document.addEventListener('keydown', releasePress, true);
      window.addEventListener('blur', releasePress);

      const availabilityHelp = document.querySelector<HTMLElement>('.availability-help');
      const availabilityButton = availabilityHelp?.querySelector('button');
      const availabilityTooltip = document.getElementById('firefox-availability-tooltip');

      if (availabilityHelp && availabilityButton && availabilityTooltip) {
        let pinned = false;
        const showTooltip = () => {
          availabilityTooltip.hidden = false;
        };
        const hideTooltip = () => {
          pinned = false;
          availabilityTooltip.hidden = true;
        };

        availabilityHelp.addEventListener('pointerenter', (event) => {
          if (event.pointerType !== 'touch') {
            showTooltip();
          }
        });
        availabilityHelp.addEventListener('pointerleave', () => {
          if (!pinned && document.activeElement !== availabilityButton) {
            hideTooltip();
          }
        });
        availabilityButton.addEventListener('focus', showTooltip);
        availabilityButton.addEventListener('blur', () => {
          if (!availabilityHelp.matches(':hover')) {
            hideTooltip();
          }
        });
        availabilityButton.addEventListener('click', () => {
          if (pinned) {
            hideTooltip();
          } else {
            pinned = true;
            showTooltip();
          }
        });
        document.addEventListener('pointerdown', (event) => {
          if (event.target instanceof Node && !availabilityHelp.contains(event.target)) {
            hideTooltip();
          }
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') {
            hideTooltip();
          }
        });
      }
    </script>
  </body>
</html>
