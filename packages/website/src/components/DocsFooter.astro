---
import DefaultFooter from '@astrojs/starlight/components/Footer.astro';
import ImageLightbox from './ImageLightbox.astro';
import { documentPath } from '../lib/documentation.ts';
---

<DefaultFooter />
<p class="privacy-link">
  <a href="/privacy/">Privacy policy</a>
  <span aria-hidden="true"> · </span>
  <a href={`/${documentPath(Astro.locals.starlightRoute.entry)}.md`}>View as Markdown</a>
</p>
<ImageLightbox />

<style>
  .privacy-link {
    margin-top: 1.5rem;
    font-size: var(--sl-text-sm);
  }
  .privacy-link a {
    color: var(--sl-color-gray-2);
  }
</style>
