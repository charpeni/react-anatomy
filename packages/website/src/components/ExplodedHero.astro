<section class="hero" aria-labelledby="hero-title">
  <div class="hero-stage">
    <div class="hero-scene">
      <div class="hero-page" aria-hidden="true">
        <span class="hero-tag">Hero</span>
      </div>
      <p class="eyebrow hero-plane hero-plane-eyebrow">
        <span class="hero-tag" aria-hidden="true">
          Eyebrow
        </span>
        A browser DevTools panel for React pages
      </p>
      <div class="hero-grid">
        <h1 id="hero-title" class="hero-plane hero-plane-heading">
          <span class="hero-tag" aria-hidden="true">
            Heading
          </span>
          See how a React page{' '}
          <span class="hero-heading-line">
            is{' '}
            <span class="hero-plane hero-plane-emphasis">
              <span class="hero-tag" aria-hidden="true">
                Emphasis
              </span>
              composed.
            </span>
          </span>
        </h1>
        <div class="hero-copy">
          <p class="hero-plane hero-plane-description">
            <span class="hero-tag" aria-hidden="true">
              Description
            </span>
            React Anatomy is a browser extension that adds an <strong>Anatomy</strong> panel to your
            browser’s developer tools. It connects the page in front of you to the components React
            rendered for it: separate the page into 3D layers, follow the real component tree, and
            read the props behind what you see.
          </p>
          <div class="hero-links hero-plane hero-plane-links">
            <span class="hero-tag" aria-hidden="true">
              Links
            </span>
            <a class="watch-link" href="#demo" data-open-example>
              <span aria-hidden="true">↗</span> Explore the example
            </a>
            <a class="text-link" href="/docs/">
              Read the guide <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const scene = document.querySelector<HTMLElement>('.hero-scene');
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');

  if (scene && !reducedMotion.matches && !scene.contains(document.activeElement)) {
    const finishEntrance = () => scene.classList.remove('is-entering');

    scene.classList.add('is-entering');
    scene.addEventListener('animationend', finishEntrance, { once: true });
    scene.addEventListener('focusin', finishEntrance, { once: true });
    reducedMotion.addEventListener('change', finishEntrance, { once: true });
  }
</script>

